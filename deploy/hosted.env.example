# Hosted (free private beta) env — NAMES ONLY. Copy to deploy/hosted.env
# (untracked), fill values locally, chmod 600, root-owned on the VM.
# NEVER commit values. NEVER echo them in commands.

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_URL=

# Auth (REQUIRED for staging/production). Generate independently.
NORTHSTAR_JWT_SECRET=
NORTHSTAR_JWT_ISSUER=
NORTHSTAR_JWT_AUDIENCE=
NORTHSTAR_JWT_ALGORITHMS=HS256

# Hostname / routing (canonical; never build security links from request headers)
DOMAIN=
PUBLIC_BASE_URL=

# Hosted posture guardrails (leave as-is for the free beta)
ENVIRONMENT=staging
NS_FOUNDATION_ALLOW_REMOTE_DEV=0
NORTHSTAR_OWNER_TEST_MODE=0
NORTHSTAR_OWNER_SELF_APPROVAL=0

# Caddy published port
HTTP_PORT=80
