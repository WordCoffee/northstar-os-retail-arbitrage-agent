# Hosted stack entrypoint. UI is served under /ui/ (Vite base); everything
# under /api/ and the health paths is reverse-proxied to the FastAPI service.
# TLS is added automatically by Caddy when DOMAIN resolves to this host; for
# plain local http://localhost the :80 site below is used as-is.
#
# P0-03 (2026-10-09): the FastAPI service now runs `main:app`, the single
# entrypoint that serves every UI-called route. Caddy proxies the health and
# AutothinK workspace paths too, so a hosted smoke test exercises the same
# surface as a local one.

{
	admin off
}

:80 {
	encode gzip

	# API + foundation health -> FastAPI (the single hosted entrypoint).
	handle /api/* {
		reverse_proxy api:8000
	}

	# Health and readiness probes used by orchestration and Monitoring.
	handle /health* {
		reverse_proxy api:8000
	}

	# AutothinK workspace shell served by the API.
	handle /autothink* {
		reverse_proxy api:8000
	}

	# Canonical SPA under /ui/ (SPA fallback to index.html).
	#
	# P0-03 follow-up (2026-10-09): this used to serve the SPA from a copy baked
	# into the caddy image (Dockerfile.ui -> /srv). That copy is a SECOND build of
	# the same frontend, so it silently went stale whenever only `api` was
	# rebuilt — the operator saw an old UI (empty suite rail, missing routes)
	# while the API was serving the new one. The SPA now comes from exactly one
	# place: the api image's in-image build. Rebuilding `api` is enough.
	#
	# NOTE: `handle`, not `handle_path` — the api mounts the SPA at /ui, so the
	# prefix must be preserved when the request is proxied.
	handle /ui/* {
		reverse_proxy api:8000
	}

	# Bare root -> the UI.
	redir / /ui/ 302
}
