FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependency layer first (cache-friendly).
COPY Northstar_backend/requirements.txt /app/Northstar_backend/requirements.txt
RUN pip install --no-cache-dir -r /app/Northstar_backend/requirements.txt

# Application code (includes migrations_foundation/ and foundation/).
COPY Northstar_backend /app/Northstar_backend

WORKDIR /app/Northstar_backend
EXPOSE 8000

# The Foundation app builds FoundationState at import; FOUNDATION_DB_URL
# selects Postgres. (Full legacy main:app is mounted in later phases.)
CMD ["uvicorn", "foundation.app:app", "--host", "0.0.0.0", "--port", "8000"]