# Northstar OS — single hosted entrypoint (P0-03, fixed 2026-10-09).
#
# The hosted stack used to run `foundation.app:app`, which serves only the
# foundation namespace and silently drops every route the suite shell calls
# (status, sourcescout, products/finder, autothink, reasoning, noncreative).
# That is why some pages worked locally and 404'd once deployed.
#
# A2 decision (applied by default): ONE entrypoint — `main:app`. It already
# mounts the foundation router, the noncreative router and every legacy route,
# so local and hosted converge with no route moves.
#
# The UI is built inside this image so `main:app` also serves the SPA at /ui/
# and the AutothinK workspace at /autothink/. That makes the hosted stack a
# single service — the shape the Oracle Always Free tier needs. Caddy stays in
# docker-compose.yml purely for TLS termination when a real domain is used.
#
# The whole repository context is copied (not just Northstar_backend/) because
# main:app resolves sibling paths against the repo root. Both the UI mount and
# the AutothinK mount degrade silently when absent, so the image still builds
# from a backend-only checkout.

# Base images pinned by multi-platform digest (resolved via buildx 2026-10-11).
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS ui-build
WORKDIR /ui
COPY northstar-os-ui/package.json northstar-os-ui/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY northstar-os-ui/ ./
RUN npm run build

FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000

WORKDIR /app

# Built SPA — served at /ui/ by main.py's mount_ui helper.
COPY --from=ui-build /ui/dist /app/northstar-os-ui/dist

# Dependency layer first (cache-friendly). Pins + hashes come from uv.lock via
# `uv export` (--no-emit-project keeps the project itself out of the file so
# --require-hashes accepts it); requirements.txt remains the human-readable
# source list. Owner-approved uv.lock build, 2026-10-11.
COPY Northstar_backend/requirements.txt Northstar_backend/pyproject.toml Northstar_backend/uv.lock /app/Northstar_backend/
RUN pip install --no-cache-dir "uv==0.13.0" \
 && uv export --frozen --no-emit-project --directory /app/Northstar_backend --output-file /tmp/northstar-requirements.txt \
 && pip install --no-cache-dir --require-hashes -r /tmp/northstar-requirements.txt

# Application code (includes migrations_foundation/, foundation/, autothink/).
COPY Northstar_backend /app/Northstar_backend
COPY autothink /app/autothink
COPY shared /app/shared

# Non-root runtime (owner directive 2026-10-11): dedicated user owns /app;
# no secrets are baked (the .env files are excluded via .dockerignore).
RUN useradd --create-home --shell /usr/sbin/nologin --uid 10001 northstar \
 && chown -R northstar:northstar /app
USER northstar

# The API runs from the backend directory: every module in main.py resolves its
# sibling imports from there, and the .env files stay outside the image.
WORKDIR /app/Northstar_backend
EXPOSE 8000

# Fail-closed posture is asserted at startup by main.lifespan:
#   - assert_prod_posture()       (rate limiter must run in production)
#   - assert_live_posture()       (no metered provider spend from a plain GET)
#   - assert_jwt_secret_posture() (no ephemeral signing key when hosted)
# A container that violates any of these exits instead of serving traffic.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status==200 else 1)"

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
