# Bright Data credentials — Web Unlocker is PRIMARY for discovery + enrichment
# (POST api.brightdata.com/request, zone northstaros, raw HTML). Billing: free
# tier = 5,000 credits/month shared pool (1 credit = 1 request), renews on the
# 1st, no rollover, hard stop at 0 when unfunded. The old dataset-trigger pair
# below remains only for the legacy brightdata_client fallback.
BRIGHTDATA_UNLOCKER_API_KEY=your_brightdata_unlocker_api_key_here
BRIGHTDATA_UNLOCKER_ZONE=northstaros
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_DATASET_ID=gd_lwdb4vjm1ehb499uxs

# Bright Data Web Unlocker HTTP options (used by bright_data_client._fetch)
# BRIGHTDATA_REQUEST_TIMEOUT_SECONDS=120
# BRIGHTDATA_REQUEST_DELAY_SECONDS=2.0

# Bright Data Web Unlocker — Costco item-detail parallel adapter
# (bright_data_costco.py). Fail-closed gate: live calls run ONLY when "1".
# Default 0. This is the Unwrangle-free path for Costco item lookup.
BRIGHTDATA_COSTCO_DETAIL_ENABLED=0

# Search behavior
SEARCH_KEYWORDS=kirkland
DEFAULT_MARKETPLACE=https://www.amazon.com
PAGES_TO_SEARCH=10

# Live Amazon search provider for the Product Scout (BRIGHTDATA | CHOCODATA | SCAVIO)
# BRIGHTDATA is PRIMARY (default). Fallbacks stay selectable:
# - Chocodata = free 1,000 credits on signup, no card (app.chocodata.com);
#   /amazon/search = 5 credits/call, so a full scan (1 keyword x 10 pages) = 50 credits
# - Scavio = default fallback
# SCANNER_SEARCH_FALLBACK=CHOCODATA|SCAVIO auto-falls back when BRIGHTDATA fails
SCANNER_SEARCH_SOURCE=BRIGHTDATA
SCANNER_SEARCH_FALLBACK=SCAVIO
CHOCODATA_API_KEY=your_chocodata_api_key_here

# Per-ASIN offer enrichment (BRIGHTDATA per-request = default primary |
# CHOCODATA = 5 credits/ASIN | UNWRANGLE amazon_detail = 1 credit/ASIN US |
# EASYPARSER = fast OFFER operation | AUTO = Easyparser first, Bright Data fallback);
# gated to Costco-matched ASINs only to control spend
SCANNER_OFFER_ENRICHMENT=BRIGHTDATA
# CHOCODATA_API_KEY=your_chocodata_api_key_here
# UNWRANGLE_API_KEY=your_unwrangle_api_key_here

# Profit thresholds
MIN_PROFIT_MARGIN_PERCENT=25
MIN_ROI_PERCENT=30
MAX_SELLER_RANK=100000

# Costco catalog connector (OPENWEBNINJA | UNWRANGLE | OFF = local CSV only)
# UNWRANGLE: Costco Business Delivery search, up to 96 products/page, 10 credits/page
COSTCO_CATALOG_SOURCE=OFF
OPENWEBNINJA_API_KEY=your_openwebninja_api_key_here
UNWRANGLE_API_KEY=your_unwrangle_api_key_here
COSTCO_CATALOG_MAX_PAGES=1
COSTCO_API_COST_BUFFER_PERCENT=10

# Costco catalog CSV (for cost basis)
COSTCO_CSV_PATH=./data/costco-items.csv

# How many top deals to export to CSV
TOP_DEALS_COUNT=20

# DataForSEO (secondary Amazon Merchant validation) — supply values ONLY in local .env
# Bright Data remains the PRIMARY discovery/enrichment source; DataForSEO is narrowly
# routed validation only (offline_design_only). Never commit real credentials.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Local-only runtime guards for the DataForSEO adapter. Default: disabled.
# These read from the local process environment only (never committed as true).
# Enable ONLY for one explicitly approved, budget-capped Standard-queue
# diagnostic, then restore to false. Leave false for normal operation.
DATAFORSEO_ENABLED=false
DATAFORSEO_TRANSPORT_ENABLED=false
# Local-only runtime guards for the DataForSEO adapter. Default: disabled.
# These are read from the local process environment (not committed) and must
# only be enabled for a single, explicitly approved, budget-capped Standard-queue
# validation diagnostic. Leave false for normal operation.
DATAFORSEO_ENABLED=false
DATAFORSEO_TRANSPORT_ENABLED=false
