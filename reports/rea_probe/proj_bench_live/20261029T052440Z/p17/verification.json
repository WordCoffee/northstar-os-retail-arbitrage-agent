[
  {
    "id": "check_1",
    "description": "Verify that replan.json exists and is valid JSON",
    "type": "file_exists_and_valid_json",
    "path": "replan.json"
  },
  {
    "id": "check_2",
    "description": "Ensure replan.json contains a 'replan_strategy' field with a non-empty string value",
    "type": "json_schema_validation",
    "path": "replan.json",
    "schema": {
      "type": "object",
      "required": ["replan_strategy"],
      "properties": {
        "replan_strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  {
    "id": "check_3",
    "description": "Confirm that the replan strategy explicitly mentions 're-plan' or 're-evaluate' rather than 'retry'",
    "type": "string_contains",
    "path": "replan.json",
    "field": "replan_strategy",
    "must_contain_any": ["re-plan", "re-evaluate", "reassess"],
    "must_not_contain": ["blind retry", "retry without analysis"]
  },
  {
    "id": "check_4",
    "description": "Validate that replan.json includes a 'failed_assertion' field identifying the specific assertion that failed",
    "type": "json_schema_validation",
    "path": "replan.json",
    "schema": {
      "type": "object",
      "required": ["failed_assertion"],
      "properties": {
        "failed_assertion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  {
    "id": "check_5",
    "description": "Ensure that replan.json contains a 'next_steps' array with at least one actionable item",
    "type": "json_schema_validation",
    "path": "replan.json",
    "schema": {
      "type": "object",
      "required": ["next_steps"],
      "properties": {
        "next_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
]
