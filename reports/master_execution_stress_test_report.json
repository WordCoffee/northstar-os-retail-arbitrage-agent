    {
      "id": "state_endpoint_serialised_probes",
      "found": "100 concurrent GET /api/admin/tys/state calls produced 92 client timeouts: every request re-probed every lane, and the Chrome Connect probe costs ~1.5 s.",
      "fix": "TysAssistant.cached_state(ttl 3 s) with an explicit ?fresh=1 escape hatch; first cold probe stays ~1.5 s, the burst then served 97-100/100 with p95 ~112 ms.",
      "evidence": "phases.gateway_http.data"
    },
    {
      "id": "per_kind_quota_ignored_total_cap",
      "found": "A 10 GB paid profile accepted a 2 GB image while 3 GB of retained video was already stored: the image cap was checked alone, so the total cap could be exceeded.",
      "fix": "Image admission now uses min(image_quota, total_quota - retained_video) and prunes against that binding cap.",
      "evidence": "phases.storage.data.paid_tier.overflow"
    },
    {
      "id": "gateway_rate_limit",
      "found": "A 100-request burst trips the gateway's own rate limiter (HTTP 429 on 3 of 100).",
      "status": "expected behaviour, verified recoverable: the throttled calls succeed after a 2 s backoff, and the offline queue already retries with bounded exponential backoff.",
      "evidence": "phases.gateway_http.data.recovery_after_backoff"
    }
