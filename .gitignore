node_modules/
.env
.env.*
!.env.example
.env.local
coverage/
data/snapshots/*.json
logs/
.DS_Store

# Northstar OS Retail Arbitrage Agent â€” repo-hygiene guards
# Prevent git add -A from ever re-sweeping a WSL venv / site-packages dump
# or a duplicate backend audit-export snapshot into the index.
venv-wsl/
venv*/
*site-packages/
__pycache__/
*.pyc
Northstar_backend_audit_export/
# Pipeline output artifacts â€” never commit generated exports (D4-F2).
# Historical blobs (commit 009ac85) embedded third-party URL query tokens;
# output dirs are now ignored going forward. History rewrite = operator decision.
data/scored/
data/normalized/

# --- Phase 1 secret hygiene (Secure Control-Layer) ---
# No credential material may ever be committed. Local runtime artifacts that
# can embed session/profile state are ignored going forward.
*.pem
*.p12
*.pfx
.chromeconnect/
.playwright-mcp/
.wrangler/tmp/

# local build snapshots (rollback tooling) - never committed
backups/

# Regenerable scan dumps (scripts rebuild them; too large to version)
reports/video_scan/*.jsonl
!reports/video_scan/github.jsonl

# Video lane working files (regenerable; keep only the published samples)
reports/video_scan/*.webm
reports/video_scan/f_*.png
reports/video_scan/batch/*
!reports/video_scan/batch/*.mp4
!reports/video_scan/batch/summary.jsonl

# Continuous Improvement Engine runtime state (regenerable, never versioned)
state/improvement/
reports/improvement/loop.log

# Deliverable packages are user output (renders + manifests), not source
state/deliverables/

# Local service launch logs (runtime)
reports/api_launch*.log

# Local dev server logs (runtime)
reports/ui_dev*.log
reports/voice*.log

# ── Generated output vs. evidence (operator-approved 2026-10-24) ───────────
# Rule: source and evidence are versioned; anything the app or a provider
# regenerates is not. A committed .db is a stale copy of one machine's state.
Northstar_backend/data/
*.db
*.db-shm
*.db-wal
# Model weights: multi-GB, re-downloadable, never versioned.
*.part0
*.gguf
*.safetensors
# Scrape and render output.
out_sb/
renders/
# Report imagery is working output — EXCEPT a named capture, because a
# screenshot is the proof in an acceptance brief.
reports/**/*.png
!reports/**/screenshots/**
# Editor/agent backup copies.
*.bak
*.bak.*

# Launcher secrets & logs (never commit)
**/opencode-password.txt
**/ollama*.log
**/opencode*.log

# Playwright test artifacts (never commit)
playwright-report/
test-results/
tests/e2e/storageState/

# Phase B local evidence: 100 public READMEs fetched for reading only.
# The CSV keeps the URL and a read note; the files are not redistributed.
research/assistant_intelligence_20261028/readmes/


# snapshot local manifests (full untracked path lists; never committed)
state/snapshots/*.local.json
