{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "limit": { "context": 120000, "output": 8192 },
          "options": {
            "provider": { "sort": "price", "allow_fallbacks": true }
          }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": { "context": 120000, "output": 8192 },
          "options": {
            "provider": { "sort": "price", "allow_fallbacks": true }
          }
        },
        "~anthropic/claude-sonnet-latest": {
          "name": "Claude Sonnet Latest",
          "limit": { "context": 180000, "output": 8192 },
          "options": {
            "provider": { "sort": "price", "allow_fallbacks": true }
          }
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "keep": { "tokens": 6000 },
    "buffer": 12000
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--extension", "--profile-dir-name", "Profile 6"],
      "enabled": true,
      "environment": { "NORTHSTAR_CC_ATTACH": "extension" }
    }
  }
}