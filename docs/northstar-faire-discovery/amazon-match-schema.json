{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AmazonMatchRecord",
  "type": "object",
  "required": ["org_id", "source", "source_record_id", "captured_at", "confidence_class"],
  "properties": {
    "org_id": { "type": "string" },
    "source": { "type": "string" },
    "source_record_id": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "provenance": { "enum": ["OBSERVED_LIVE", "OPERATOR_SUPPLIED", "CACHED", "DERIVED", "UNKNOWN"] },
    "staleness_seconds": { "type": ["integer", "null"] },
    "confidence_class": {
      "enum": ["EXACT_IDENTIFIER_MATCH", "EXACT_ATTRIBUTE_MATCH", "PROBABLE_MATCH_REVIEW_REQUIRED", "AMBIGUOUS", "MISMATCH", "INSUFFICIENT_DATA"]
    },
    "match_priority_used": { "enum": ["GTIN", "MPN_BRAND", "MODEL_BRAND", "ATTRIBUTES", "FUZZY"] },
    "asin": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{10}$" },
    "amazon_url": { "type": ["string", "null"] },
    "marketplace": { "type": "string", "const": "amazon.com" },
    "brand": { "type": ["string", "null"] },
    "amazon_title": { "type": ["string", "null"] },
    "manufacturer": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "mpn": { "type": ["string", "null"] },
    "gtin": { "type": ["string", "null"] },
    "upc": { "type": ["string", "null"] },
    "ean": { "type": ["string", "null"] },
    "item_form": { "type": ["string", "null"] },
    "color": { "type": ["string", "null"] },
    "size": { "type": ["string", "null"] },
    "unit_count": { "type": ["integer", "null"] },
    "number_of_items": { "type": ["integer", "null"] },
    "item_package_quantity": { "type": ["integer", "null"] },
    "product_dimensions_in": { "type": ["string", "null"] },
    "package_dimensions_in": { "type": ["string", "null"] },
    "item_weight_lb": { "type": ["string", "null"] },
    "package_weight_lb": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"] },
    "selling_price": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "buy_box_price": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "amazon_seller_present": { "type": ["boolean", "null"] },
    "fba_seller_count": { "type": ["integer", "null"] },
    "fbm_seller_count": { "type": ["integer", "null"] },
    "total_seller_count": { "type": ["integer", "null"] },
    "review_count": { "type": ["integer", "null"] },
    "rating": { "type": ["number", "null"] },
    "bsr": { "type": ["integer", "null"] },
    "estimated_monthly_sales": { "type": ["number", "null"] },
    "price_history_summary": { "type": ["object", "null"] },
    "listing_age_days": { "type": ["integer", "null"] },
    "variation_relationships": { "type": "array", "items": { "type": "string" } },
    "restricted_product_indicators": { "type": ["string", "null"] },
    "hazmat_indicators": { "type": ["string", "null"] },
    "meltable_indicators": { "type": ["string", "null"] },
    "eligibility_state": {
      "enum": ["ELIGIBLE_CONFIRMED", "APPROVAL_REQUIRED", "RESTRICTED", "NOT_ELIGIBLE", "ELIGIBILITY_UNKNOWN", "ELIGIBILITY_CHECK_UNAVAILABLE"]
    },
    "evidence_source": { "type": ["string", "null"] },
    "capture_ts": { "type": ["string", "null"], "format": "date-time" },
    "staleness": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
