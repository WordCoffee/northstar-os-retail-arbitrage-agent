{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FaireDiscoveryRecord",
  "description": "Faire is a DISCOVERY source only. Wholesale pricing is DISCOVERY_BENCHMARK_ONLY — amazon resale through Faire not authorized.",
  "type": "object",
  "required": ["org_id", "source", "source_record_id", "captured_at", "provenance", "confidence", "brand"],
  "properties": {
    "org_id": { "type": "string" },
    "source": { "type": "string", "const": "faire" },
    "source_record_id": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "effective_at": { "type": ["string", "null"], "format": "date-time" },
    "provenance": { "enum": ["OBSERVED_LIVE", "OPERATOR_SUPPLIED", "CACHED", "DERIVED", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "staleness_seconds": { "type": ["integer", "null"], "minimum": 0 },
    "created_by": { "type": ["string", "null"] },
    "updated_by": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "wholesale_pricing_label": { "type": "string", "const": "DISCOVERY_BENCHMARK_ONLY — AMAZON RESALE THROUGH FAIRE NOT AUTHORIZED" },
    "brand": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "faire_brand_url": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"] },
        "legal_name": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "categories": { "type": "array", "items": { "type": "string" } },
        "brand_values": { "type": "array", "items": { "type": "string" } },
        "not_on_amazon_designation": { "type": ["boolean", "null"] },
        "marketplace_restrictions": { "type": ["string", "null"] },
        "resale_restrictions": { "type": ["string", "null"] },
        "map_policy": { "type": ["string", "null"] },
        "territory_restrictions": { "type": ["string", "null"] },
        "direct_wholesale_available": { "type": ["boolean", "null"] },
        "wholesale_application_url": { "type": ["string", "null"] },
        "evidence_url": { "type": ["string", "null"] },
        "capture_ts": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "product": {
      "type": "object",
      "properties": {
        "title": { "type": ["string", "null"] },
        "faire_product_url": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "sku": { "type": ["string", "null"] },
        "mpn": { "type": ["string", "null"] },
        "gtin": { "type": ["string", "null"] },
        "upc": { "type": ["string", "null"] },
        "ean": { "type": ["string", "null"] },
        "variant": { "type": ["string", "null"] },
        "color": { "type": ["string", "null"] },
        "size": { "type": ["string", "null"] },
        "material": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "wholesale_case_price": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "wholesale_unit_price": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "case_quantity": { "type": ["integer", "null"], "minimum": 0 },
        "inner_pack_quantity": { "type": ["integer", "null"], "minimum": 0 },
        "minimum_order_quantity": { "type": ["integer", "null"], "minimum": 0 },
        "opening_order_minimum": { "type": ["string", "null"] },
        "reorder_minimum": { "type": ["string", "null"] },
        "suggested_retail_price": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "shipping_estimate": { "type": ["string", "null"] },
        "lead_time": { "type": ["string", "null"] },
        "inventory_status": { "type": ["string", "null"] },
        "product_weight_lb": { "type": ["string", "null"] },
        "packaged_shipping_weight_lb": { "type": ["string", "null"] },
        "product_dimensions_in": { "type": ["string", "null"] },
        "packaged_dimensions_in": { "type": ["string", "null"] },
        "country_of_origin": { "type": ["string", "null"] },
        "compliance_claims": { "type": ["array", "items": { "type": "string" }] },
        "fragility": { "type": ["string", "null"] },
        "hazmat_indicators": { "type": ["string", "null"] },
        "expiration_indicators": { "type": ["string", "null"] },
        "manufacturer_pack_status": { "type": ["string", "null"] },
        "image_urls": { "type": "array", "items": { "type": "string" } },
        "evidence_url": { "type": ["string", "null"] },
        "capture_ts": { "type": ["string", "null"], "format": "date-time" },
        "provenance_class": { "enum": ["OBSERVED_LIVE", "OPERATOR_SUPPLIED", "CACHED", "DERIVED", "UNKNOWN", null] }
      }
    }
  }
}
