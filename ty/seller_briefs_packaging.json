{
  "schema": "northstar.seller_briefs.packaging.v1",
  "note": "Packaging deliverables, not pictures: each brief asks the app for a print-ready dieline for a named product. A picture can be retouched; a dieline either folds or it does not. Every parameter below is a real product's, and every brief names the panels the manufactured package has.",
  "briefs": [
    {
      "id": "PK-001",
      "product": "MOGRA organic lion's mane mushroom powder, 170 g",
      "brand": "MOGRA ORGANICS",
      "template": "doypack",
      "params": {
        "width_mm": 140,
        "height_mm": 220,
        "gusset_mm": 40,
        "bleed_mm": 3,
        "safe_mm": 5,
        "fill_g": 170
      },
      "expect": {
        "min_bleed_mm": 3,
        "min_safe_mm": 5,
        "layers": [
          "trim",
          "fold",
          "safe",
          "bleed"
        ],
        "panel_names": [
          "front",
          "back",
          "gusset"
        ],
        "min_panels": 3
      }
    },
    {
      "id": "PK-002",
