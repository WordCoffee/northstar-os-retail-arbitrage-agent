{
  "name": "northstar-os-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Northstar OS SPA — SIGNAL design system",
  "scripts": {
    "dev": "vite --port 8101 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 8101 --strictPort",
    "test:ui": "node --test \"src/lib/*.test.js\"",
