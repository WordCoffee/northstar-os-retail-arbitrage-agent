    "test": "npm run test:ui && npm run test:contrast && npm run verify:galactic",
    "verify:galactic": "node scripts/verify-galactic-deck.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}